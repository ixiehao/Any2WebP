{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any2WebP",
  "version": "0.2.30",
  "identifier": "com.ixiehao.any2webp",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Any2WebP",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 26 },
        "width": 1240,
        "height": 775,
        "minWidth": 820,
        "minHeight": 625
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "externalBin": ["binaries/any2webp-codec"],
    "resources": ["../docs/THIRD-PARTY-NOTICES.txt"],
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
